{
  "name": "@seanhogg/builderforce-memory-engine",
  "version": "2026.8.21",
  "description": "BuilderForce Agent Memory — engine layer. TypeScript/WGSL Mamba SSM kernels, model blocks, autograd, training, and BPE tokenizer (zero runtime deps, WebGPU-native).",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "type": "module",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "serve": "node serve.js",
    "bench:adapt": "npm run build && node scripts/bench-adaptation.mjs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint src/ tests/",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "typecheck:native": "tsgo --noEmit"
  },
  "keywords": [
    "mamba",
    "ssm",
    "state-space-model",
    "webgpu",
    "wgsl",
    "machine-learning",
    "code-model",
    "bpe",
    "transformer-alternative",
    "agent-memory",
    "builderforce",
    "typescript"
  ],
  "author": {
    "name": "Sean Hogg",
    "email": "seanhogg@gmail.com",
    "url": "https://builderforce.ai"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SeanHogg/builderforce-memory.git",
    "directory": "packages/memory-engine"
  },
  "bugs": {
    "url": "https://github.com/SeanHogg/builderforce-memory/issues"
  },
  "homepage": "https://github.com/SeanHogg/builderforce-memory/tree/main/packages/memory-engine#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@webgpu/types": "^0.1.49",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^6.0.3",
    "@typescript/native-preview": "7.0.0-dev.20260627.2"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": {
            "module": "ES2022",
            "moduleResolution": "bundler",
            "rootDir": ".",
            "strict": true,
            "esModuleInterop": true,
            "skipLibCheck": true,
            "types": [
              "@webgpu/types",
              "jest"
            ]
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}
